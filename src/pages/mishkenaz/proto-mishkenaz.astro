---
// src/pages/mishkenaz/proto-mishkenaz.astro
// Komplett neu — ersetzt die Schwäbische-Alb-Version
// Stand: Juni 2026

import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Urgesten — Proto-Mishkenaz";
const description = "Die zwölf Urgesten sind das physiologische Fundament von Mishkenaz: Körperpositionen mit Bedeutungsrichtungen, aus denen alle Vektoren und Phoneme abgeleitet werden.";
---

<BaseLayout title={title} description={description}>

<style>
  .proto-page { max-width: var(--max-width); margin: 0 auto; padding: 0 2rem 4rem; }

  .page-header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--gold-light);
  }
  .breadcrumb {
    font-family: 'Lato', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .breadcrumb a { color: var(--color-petrol); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span { color: var(--text-muted); margin: 0 0.5rem; }

  .page-header h1 {
    font-family: 'Crimson Text', serif;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 400;
    color: var(--dark);
    margin: 0 0 0.5rem;
  }
  .page-header .sub {
    font-family: 'Lora', serif;
    font-size: 1.1rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .intro-box {
    background: var(--bg-soft);
    border-left: 3px solid var(--gold);
    padding: 1.25rem 1.75rem;
    margin: 2rem 0;
    font-family: 'Lora', serif;
    font-size: 0.97rem;
    line-height: 1.75;
  }

  .sektion { padding: 2.5rem 0; border-bottom: 1px solid var(--border); }
  .sektion h2 {
    font-family: 'Crimson Text', serif;
    font-size: 1.75rem;
    font-weight: 400;
    color: var(--dark);
    margin-bottom: 1rem;
  }
  .sektion p {
    font-family: 'Lora', serif;
    font-size: 0.97rem;
    line-height: 1.8;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .urgesten-tabelle {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-family: 'Lora', serif;
    font-size: 0.9rem;
  }
  .urgesten-tabelle th {
    background: var(--dark);
    color: #FAF8F3;
    padding: 0.6rem 1rem;
    text-align: left;
    font-family: 'Lato', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .urgesten-tabelle td {
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .urgesten-tabelle tr:hover td { background: var(--bg-soft); }
  .urgesten-tabelle .nr {
    color: var(--color-petrol);
    font-family: 'Lato', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .urgesten-tabelle .name {
    font-family: 'Crimson Text', serif;
    font-size: 1.15rem;
    color: var(--gold);
    font-weight: 600;
  }

  .hinweis {
    background: #f0f7f7;
    border-left: 3px solid var(--color-petrol);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    font-family: 'Lora', serif;
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .ableitungs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .ableitungs-karte {
    border: 1px solid var(--border);
    padding: 1rem 1.25rem;
    font-family: 'Lora', serif;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .ableitungs-karte .urgeste {
    font-family: 'Crimson Text', serif;
    font-size: 1.1rem;
    color: var(--gold);
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .ableitungs-karte .phoneme { color: var(--color-petrol); margin: 0.2rem 0; }
  .ableitungs-karte .prinzip { color: var(--text-muted); font-size: 0.82rem; font-style: italic; }

  .mish-nav {
    display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.5rem 0;
  }
  .mish-nav a {
    font-family: 'Lato', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-petrol);
    text-decoration: none;
    border: 1px solid var(--color-petrol);
    padding: 0.4rem 1rem;
    transition: all 0.2s;
  }
  .mish-nav a:hover { background: var(--color-petrol); color: white; }

  @media (max-width: 640px) {
    .urgesten-tabelle { font-size: 0.82rem; }
    .ableitungs-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<div class="proto-page">

  <header class="page-header">
    <p class="breadcrumb">
      <a href="/mishkenaz">Mishkenaz</a>
      <span>›</span>
      Urgesten
    </p>
    <h1>Die zwölf Urgesten</h1>
    <p class="sub">Das physiologische Fundament von Mishkenaz</p>
  </header>

  <div class="intro-box">
    Die Urgesten sind nicht die ältesten bekannten Sprachfunde. Sie sind das <strong>theoretische Fundament</strong> von Mishkenaz: die Antwort auf die Frage, welche körperlichen Bewegungen allen menschlichen Lauten vorausgehen. Zwölf Körperpositionen — jede mit einer Lautklasse und einer Bedeutungsrichtung. Keine Phoneme, sondern Artikulationsereignisse. Aus jeder Urgeste entstehen mehrere Phoneme, je nachdem welcher Ausgang gewählt wird.
  </div>

  <section class="sektion">
    <h2>Die Tabelle</h2>

    <table class="urgesten-tabelle">
      <thead>
        <tr><th>#</th><th>Name</th><th>Körper</th><th>Bedeutungsrichtung</th></tr>
      </thead>
      <tbody>
        <tr><td class="nr">1</td><td class="name">Oh</td><td>Mund weit-rund, tief</td><td>Offenheit, Staunen, Weite</td></tr>
        <tr><td class="nr">2</td><td class="name">Ah</td><td>Mund maximal offen</td><td>Weite, Raumgeben, das Äußerste</td></tr>
        <tr><td class="nr">3</td><td class="name">Om</td><td>Rund, nasal schließend</td><td>Stimmigkeit, Ankommen — Om als untrennbare Einheit, nicht O+M</td></tr>
        <tr><td class="nr">4</td><td class="name">Ma</td><td>Bilabial-nasal, Saugbewegung</td><td>Bindung, Nähren — gibt M (nasal)</td></tr>
        <tr><td class="nr">5</td><td class="name">Pa</td><td>Bilabial explosiv</td><td>Impuls, Echo — gibt P/B als Paar (B kommt von Pa, nicht Ma)</td></tr>
        <tr><td class="nr">6</td><td class="name">Sa</td><td>Frikativ, Zahn-Lippen</td><td>Schwelle, Bruch, Übergang — gibt S / Z / SH</td></tr>
        <tr><td class="nr">7</td><td class="name">Auv</td><td>Diphthong, fließend tief, labial</td><td>Fließende Tiefe, Tragen, Bewegung ohne Ziel</td></tr>
        <tr><td class="nr">8</td><td class="name">Avi</td><td>Zentralvokal (Schwa ə), minimal markiert</td><td>Leere, Nullpunkt, Potenzial — V00, kein Duplikat von Ah</td></tr>
        <tr><td class="nr">9</td><td class="name">Il</td><td>Hoher Vokal, Zunge vorne</td><td>Bewegung, Sehnsucht, Unterwegs-sein — gibt I / L / J/Y</td></tr>
        <tr><td class="nr">10</td><td class="name">Ku</td><td>Velar, Kehlenraum</td><td>Hohlraum, Suche — gibt K / G / Ng</td></tr>
        <tr><td class="nr">11</td><td class="name">Bi</td><td>Bilabial, hoher Vokal — Startposition</td><td>Ansatzpunkt, Quelle — vokalisch-positional, kein eigener Plosiv</td></tr>
        <tr><td class="nr">12</td><td class="name">Ta</td><td>Alveolar, Zunge/Gaumen</td><td>Gegenüber, Grenze, das Andere — gibt T / D / N / R</td></tr>
      </tbody>
    </table>

    <div class="hinweis">
      <strong>Om als Einheit:</strong> Om ist phonologisch nicht O+M — der Übergang von Vokalrundung in den nasalen Verschluss ist eine einzige Geste, keine Sequenz.<br><br>
      <strong>Avi als Schwa (ə):</strong> Avi ist der unbetonbare Zentralvokal — der am wenigsten markierte Laut. Eigenständig, kein Duplikat von Ah. Er entspricht dem Vektor V00 — dem Nullpunkt außerhalb der 42.
    </div>
  </section>

  <section class="sektion">
    <h2>Das Ableitungsprinzip</h2>
    <p>Eine Urgeste ist eine Körperposition. Die Phoneme entstehen durch verschiedene Ausgangswege — oral oder nasal, stimmhaft oder stimmlos, lateral oder direkt. Aus zwölf Urgesten entstehen so ~25 Phoneme des R1-Inventars.</p>

    <div class="ableitungs-grid">
      <div class="ableitungs-karte"><p class="urgeste">Ku →</p><p class="phoneme">K (stimmlos) · G (stimmhaft) · Ng (nasal)</p><p class="prinzip">Dieselbe veleare Geste, drei Ausgänge</p></div>
      <div class="ableitungs-karte"><p class="urgeste">Il →</p><p class="phoneme">I · E · L (lateral) · J/Y (Gleitlaut)</p><p class="prinzip">Zunge berührt Gaumen → Lateral</p></div>
      <div class="ableitungs-karte"><p class="urgeste">Ma →</p><p class="phoneme">M (nasal)</p><p class="prinzip">Pa gibt P/B — Ma gibt nur M</p></div>
      <div class="ableitungs-karte"><p class="urgeste">Pa →</p><p class="phoneme">P (stimmlos) · B (stimmhaft)</p><p class="prinzip">Impuls-Plosiv-Paar</p></div>
      <div class="ableitungs-karte"><p class="urgeste">Ta →</p><p class="phoneme">T · D · N · R</p><p class="prinzip">Alveolarer Raum: vier Ausgänge</p></div>
      <div class="ableitungs-karte"><p class="urgeste">Sa →</p><p class="phoneme">S · Z · SH</p><p class="prinzip">Frikativ: stimmlos / stimmhaft / palatalisiert</p></div>
    </div>

    <nav class="mish-nav">
      <a href="/mishkenaz/grammatik">Zur Grammatik →</a>
      <a href="/mishkenaz/vektoren">Zu den 42 Vektoren →</a>
      <a href="/mishkenaz">← Mishkenaz Übersicht</a>
    </nav>
  </section>

</div>
</BaseLayout>
