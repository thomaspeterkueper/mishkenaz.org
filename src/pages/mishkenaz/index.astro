---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MISHKENAZ_CANON_VERSION, aspects } from '../../data/mishkenaz/core';

const title = 'Mishkenaz — Anatomie einer erfundenen Sprache';
const description = 'Mishkenaz ist eine konstruierte Sprache des Baumeister-Universums: Körper, Urgesten, 42 Vektoren, Resonanzaspekte, Register und Galut-Kontaktlinien.';

const galut = [
  ['G1 Galut-Bri\'ith', 'Levante / Hebräisch', 'Liturgie, Schutzformeln, Text'],
  ['G2 Galut-Sahara', 'Arabische Wüste', 'Körperwissen, Kürze, Dringlichkeit'],
  ['G3 Galut-Eil / Auv-Breth', 'Keltische Inseln', 'Gesang, Prosodie, mündliche Überlieferung'],
  ['G4 Galut-Saraswath', 'Sanskrit / Kaschmir', 'Systematisierung, Philosophie'],
  ['G5 Galut-Yin', 'Ostasiatischer Raum', 'Tonalität, Klang als grammatische Information'],
];

const registers = [
  ['R1', 'rekonstruierte Dvārakā-Grundform', 'Referenz für Grammatik und Vektoren'],
  ['R2 Vorath', 'ältestes liturgisches Register', 'nur in Liedform überliefert'],
  ['R4 Tessán', 'transversale Velun-Linie', 'keine chronologische vierte Stufe'],
  ['G6 Galut-Endia', 'transversale synthetische Kontaktlage', 'keine sechste historische Station nach G5'],
];
---

<BaseLayout title={title} description={description}>
<style>
  .mish-page { max-width: var(--max-width); margin: 0 auto; padding: 0 2rem 4rem; }
  .hero { padding: 4rem 0 3rem; border-bottom: 1px solid var(--gold-light); }
  .hero .supertitle { font-family:'Lato',sans-serif; font-size:.65rem; font-weight:700; letter-spacing:.25em; text-transform:uppercase; color:var(--color-petrol); }
  .hero h1 { font-family:'Crimson Text',serif; font-size:clamp(3rem,6vw,5rem); font-weight:400; line-height:1; margin:.65rem 0 1rem; color:var(--dark); }
  .hero .sub { font-family:'Lora',serif; font-size:1.15rem; color:var(--text-muted); font-style:italic; }
  .intro, .note { font-family:'Lora',serif; line-height:1.75; padding:1.15rem 1.5rem; margin:1.6rem 0; }
  .intro { background:var(--bg-soft); border-left:3px solid var(--gold); }
  .note { background:var(--color-petrol-light); border-left:3px solid var(--color-petrol); font-size:.91rem; }
  .nav { display:flex; flex-wrap:wrap; gap:.7rem; margin:1.5rem 0 1rem; }
  .nav a { font-family:'Lato',sans-serif; font-size:.64rem; font-weight:700; text-transform:uppercase; letter-spacing:.18em; color:var(--color-petrol); text-decoration:none; border:1px solid var(--color-petrol); padding:.42rem .9rem; }
  .nav a:hover { background:var(--color-petrol); color:white; }
  .section { padding:2.35rem 0; border-bottom:1px solid var(--border); }
  .section h2 { font-family:'Crimson Text',serif; font-size:1.9rem; font-weight:400; color:var(--dark); margin:0 0 .9rem; }
  .section h3 { font-family:'Lato',sans-serif; font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.18em; color:var(--color-petrol); margin:1.5rem 0 .55rem; }
  .section p, .section li { font-family:'Lora',serif; font-size:.96rem; line-height:1.75; }
  .cards { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin:1rem 0; }
  .card { border:1px solid var(--gold-light); padding:1rem 1.15rem; }
  .card code { color:var(--gold); font-size:1.1rem; }
  .card strong { display:block; color:var(--color-petrol); margin:.35rem 0; }
  .card p { font-size:.85rem; margin:.2rem 0; }
  table { width:100%; border-collapse:collapse; margin:1rem 0; font-family:'Lora',serif; font-size:.9rem; }
  th { background:var(--dark); color:#FAF8F3; padding:.6rem .8rem; text-align:left; font-family:'Lato',sans-serif; font-size:.62rem; text-transform:uppercase; letter-spacing:.1em; }
  td { padding:.65rem .8rem; border-bottom:1px solid var(--border); vertical-align:top; }
  .book { border:1px solid var(--gold); padding:1.35rem 1.6rem; margin:1rem 0; }
  .book .status { font-family:'Lato',sans-serif; font-size:.64rem; font-weight:700; text-transform:uppercase; letter-spacing:.16em; color:var(--gold); }
  .book blockquote { font-family:'Crimson Text',serif; font-size:1.25rem; font-style:italic; border-left:2px solid var(--gold); padding-left:1rem; margin:1rem 0 .2rem; }
  .canon { font-family:'Lato',sans-serif; font-size:.63rem; letter-spacing:.14em; text-transform:uppercase; color:var(--text-muted); }
  @media (max-width:700px) { .cards { grid-template-columns:1fr; } table { font-size:.8rem; } }
</style>

<div class="mish-page">
  <section class="hero">
    <p class="supertitle">Eine konstruierte Sprache</p>
    <h1>Mishkenaz</h1>
    <p class="sub">Aus dem Körper. Durch Überlieferung. Verändert durch Kontakt.</p>
  </section>

  <div class="intro">
    <strong>Mishkenaz</strong> ist eine bewusst konstruierte Sprache und zugleich eine fiktive Sprachgeschichte. Das System koppelt Körper und Laut, semantische Vektoren, Grammatik und Überlieferung. Es ist keine wiederentdeckte Ursprache der Menschheit und keine naturwissenschaftliche Theorie.
    <p class="canon">Website-Referenzstand v{MISHKENAZ_CANON_VERSION}</p>
  </div>

  <nav class="nav">
    <a href="/mishkenaz/vektoren">42 Vektoren →</a>
    <a href="/mishkenaz/grammatik">Grammatik →</a>
    <a href="/mishkenaz/proto-mishkenaz">Urgesten →</a>
    <a href="/mishkenaz/woerterbuch">Wörterbuch →</a>
    <a href="/mishkenaz/rueckuebersetzung">Rückübersetzungen →</a>
  </nav>

  <section class="section">
    <h2>Die Architektur</h2>
    <p>Der Kern besteht aus <strong>V00 Avi als Nullpunkt</strong> und <strong>42 Vektoren V01–V42</strong> in sieben Oktaven zu je sechs Vektoren. Ein Vektor ist keine feste Wörterbuchbedeutung, sondern eine gerichtete semantische Kraft. Kombination und Aspekt bestimmen den konkreten Ausdruck.</p>
    <p>Die drei grundlegenden Vollzugselemente des Systems sind <strong>Tav-Ritm</strong>, <strong>Kol</strong> und <strong>Vya-La</strong>: Rhythmus, Laut und gerichteter Zwischenraum.</p>

    <h3>Drei Resonanzaspekte</h3>
    <div class="cards">
      {aspects.map((aspect) => (
        <article class="card">
          <code>{aspect.suffix}</code>
          <strong>{aspect.label}</strong>
          <p>{aspect.meaning}</p>
        </article>
      ))}
    </div>
    <p>Die bewusste Auslassung eines Aspekts ist ein markierter Schweigeplatz, kein vierter Aspekt. <code>-tum</code> gehört ebenfalls nicht zu den Aspekten, sondern markiert Deprivation: schmerzhaftes Fehlen.</p>
  </section>

  <section class="section">
    <h2>Bindung braucht Grenze</h2>
    <p>Eine zentrale Prägung der Sprache ist die Ta-Konstante. Der Apostroph ist dabei wichtig: Er markiert eine historisch geprägte Einheit, nicht eine frei gebildete transparente Sequenz.</p>
    <div class="note"><strong>Ma'U</strong> — Bindung ohne Grenze: Verschmelzung / Übergriff.<br /><strong>Ma'Ta'U</strong> — Bindung mit Grenze: Verbindung, die Differenz erhält.</div>
  </section>

  <section class="section">
    <h2>Galut: historische Kontaktlinien</h2>
    <p>G1–G5 sind historische bzw. kulturelle Überlieferungs- und Kontaktlinien. Keine bewahrt das vollständige System; jede verändert Lautung, Oberflächenstruktur oder Gebrauch.</p>
    <table>
      <thead><tr><th>Linie</th><th>Kontaktzone</th><th>Charakteristisch bewahrt</th></tr></thead>
      <tbody>{galut.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
    </table>
  </section>

  <section class="section">
    <h2>Register und transversale Linien</h2>
    <p>Registerziffern bilden <strong>keine Chronologie</strong>. R4 ist nicht einfach jünger als R2. Ebenso ist G6 Galut-Endia keine historische Station, die nach G5 folgt.</p>
    <table>
      <thead><tr><th>Bezeichnung</th><th>Funktion</th><th>Einordnung</th></tr></thead>
      <tbody>{registers.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
    </table>
    <p><em>Logos universal, Phonos lokal.</em> Die Tiefenrelationen können erkennbar bleiben, während Lautform, Register, Substrat und kulturelle Deutung driften.</p>
  </section>

  <section class="section">
    <h2>Das Buch</h2>
    <div class="book">
      <p class="status">Arbeitsstand v0.9 · 2026</p>
      <p><strong>MISHKENAZ — Anatomie einer erfundenen Sprache</strong></p>
      <p>Das Buch rekonstruiert nicht nur Regeln, sondern den Weg, wie aus Körperereignissen, Lauten, Vektoren, Schrift und Überlieferung ein Sprachsystem entsteht. Reale Linguistik, Archäologie und Kulturgeschichte dienen dabei als Anker und Vergleich — nicht als Beweis für die fiktive Geschichte.</p>
      <blockquote>„Man trägt keine vollständige Sprache mit sich, wenn man flieht. Man trägt Lieder.“</blockquote>
    </div>
  </section>

  <section class="section">
    <h2>Was die Referenz bewusst offenlässt</h2>
    <p>Zwei Fragen sind noch echte Kanonfragen und werden nicht durch Website-Text entschieden: Erstens, ob die Resonanzaspekte perspektivisch-relational oder ontisch zu lesen sind. Zweitens, wie <em>Ona-nO (V35)</em> — Ur-Einheit/Rückkehr — philosophisch genau zu verstehen ist.</p>
  </section>

  <nav class="nav">
    <a href="/mishkenaz/vektoren">Vektoren im Detail →</a>
    <a href="/mishkenaz/grammatik">Grammatik im Detail →</a>
    <a href="/mishkenaz/proto-mishkenaz">Urgesten →</a>
  </nav>
</div>
</BaseLayout>
