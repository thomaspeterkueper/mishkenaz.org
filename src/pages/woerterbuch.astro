    ],
  },
  {
    titel: 'Grammatische Formen',
    text: 'Ausführlich in der Grammatik.',
    eintraege: [
      { w: '-om', de: 'tragend, stimmig – Stellungnahme des Sprechers', en: 'Holding (resonance aspect)' },
      { w: '-ath', de: 'dissonant, nicht tragend', en: 'Dissonant (resonance aspect)' },
      { w: '-il', de: 'suchend, offen, werdend', en: 'Seeking, open (resonance aspect)' },
      { w: '-tum', de: 'Deprivation – schmerzhaftes, unwiederbringliches Fehlen', en: 'Deprivation marker' },
      { w: 'wi-', de: 'Verneinung', en: 'Negation' },
      { w: "bi'", de: 'Rollenpartikel: von (Quelle)', en: 'From (source)' },
      { w: "la'", de: 'Rollenpartikel: zu (Ziel, Gegenüber)', en: 'To (goal)' },
