const sektionen: { titel: string; text?: string; eintraege: Eintrag[] }[] = [
  {
    titel: 'Kern-Vektoren',
    eintraege: [
      { w: 'Avi', de: 'Leere, Nullpunkt, offene Möglichkeit', en: 'Void, zero point, potential', note: 'V00 · Urgeste Avi (Schwa ə)' },
      { w: 'Sol', de: 'Impuls, Beginn, erster Stoß', en: 'Impulse, beginning', note: 'V01' },
      { w: 'Mira', de: 'Welle, Schwingung, Rhythmus', en: 'Wave, oscillation, rhythm', note: 'V02 · Omnizedenz ∼ Mira' },
      { w: 'Sa', de: 'Bruch, Schwelle, Übergang', en: 'Break, threshold', note: 'V03 · Urgeste Sa' },
