      { w: "Ma'Ta'U", de: 'Liebe – Bindung mit Grenze und Schutz', en: 'Love', note: 'Ma + Ta + U · Ta-Konstante' },
      { w: 'Ma-U', de: 'Bindung ohne Grenze – Verschmelzung (Schatten der Liebe)', en: 'Fusion, enmeshment', note: 'Ma + U' },
      { w: "Pa'Ta", de: 'Verantwortung – Antwort an ein Gegenüber, das widersprechen kann', en: 'Responsibility', note: 'Pa + Ta · Omnizedenz 🌋 Kesh · neu 25.10.2026' },
      { w: "Om'Ta", de: 'Stimmigkeit, die das Andere einschließt', en: 'Coherence that includes the other', note: 'Om + Ta · Omnizedenz ✓ Palya · neu 25.10.2026' },
      { w: 'Om-Kin', de: 'Verstehen durch Tun – der Geist, der im Körper handelt', en: 'Embodied understanding', note: 'Om + Kin · Omnizedenz ∫ Lume · neu 25.10.2026' },
      { w: 'Vya-Ma', de: 'Anziehung, Attraktor (Schatten: Obsession)', en: 'Attraction', note: 'Vya + Ma · Suffixform -vama · neu 25.10.2026' },
      { w: 'Om-Bi-La', de: 'Heimat – Person, Ort, Erlaubnis', en: 'Home', note: 'Om (verkörpertes Selbst) + Bi + La' },
      { w: 'Avi-Saha', de: 'Andacht – das Schauen in die Leere', en: 'Devotion, meditation', note: 'Avi + Saha' },
