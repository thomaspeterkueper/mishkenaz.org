      { w: '-vya', de: 'Richtung (zu V05 Vya)', en: 'Direction', note: 'V41 · Funktion als Meta-Operator noch auszuarbeiten' },
      { w: '-kora', de: 'Integration – die dritte Option; Schatten: Verschmelzung', en: 'Integration', note: 'V42 · Omnizedenz ⊕ Kora' },
      { w: '-ori', de: 'Wiederkehr unter verändertem Zustand, Spirale', en: 'Recursion, spiral return', note: 'V36 · Omnizedenz ⟳ Ori' },
    ],
  },
  {
    titel: 'Historische Formen und Weltbild der Sprecher',
    text: 'Diese Formen sind belegt, gehören aber einer älteren Schicht oder dem Weltbild der Sprecher an. Sie gelten nicht als Kanonsprache.',
    eintraege: [
      { w: '-ira', de: 'Anziehung, Attraktor, Obsession', note: 'Galut-Bedeutung; im Kanon: -vama', ebene: 'H' },
      { w: 'Sa-Ta-Ira', de: 'Schadenfreude', note: 'Galut-Form; Kanon: Sa-Ta-vama', ebene: 'H' },
      { w: '-kran', de: 'Differenzierung, Klarheit, Abstand', note: 'ältere Zählung V41; im kanonischen 42er-System nicht enthalten', ebene: 'H' },
      { w: 'Qadesh-La-om', de: 'heilige Öffnung – stimmig (Schutzformel)', note: "G1 Galut-Bri'ith", ebene: 'H' },
      { w: 'Sôveth', de: 'das Gefälle – im Weltbild der Sprecher die bevorzugte Richtung des Geschehens', note: 'Sa-h-Vya · Entropie-Metapher', ebene: 'H' },
    ],
  },
];
---
<Layout title="Wörterbuch" description="Mishkenaz – Deutsch: Kern-Vektoren, Pronomen, Komposita, grammatische Formen und Meta-Operatoren, mit Suche.">
  <h1>Wörterbuch</h1>
  <p class="lede">Mishkenaz – Deutsch. Die Einträge folgen der Kanonsprache; ältere Formen und Wörter aus dem Weltbild der Sprecher stehen gesondert und sind gekennzeichnet.</p>

  <section class="status">
    <strong>Epistemischer Status</strong>
    <p>Alle Wörter sind Teil einer konstruierten Sprache. Bedeutungen und Zerlegungen sind Mishkenaz-Setzungen, keine etymologischen Aussagen über reale Sprachen.</p>
  </section>

  <input id="suche" type="search" placeholder="Suchen: Mishkenaz oder Deutsch …" aria-label="Wörterbuch durchsuchen" />

  {sektionen.map((s) => (
    <section class="dict" data-sektion>
      <h2>{s.titel}</h2>
      {s.text && <p class="note">{s.text}</p>}
      <div class="grid">
        {s.eintraege.map((e) => (
          <article data-s={`${e.w} ${e.de} ${e.en ?? ''} ${e.note ?? ''}`.toLowerCase()} class={e.ebene === 'H' ? 'h' : ''}>
            <code>{e.w}</code>
            <p>{e.de}</p>
            {e.en && <p class="en">{e.en}</p>}
            {e.note && <small>{e.note}</small>}
            {e.ebene === 'H' && <span class="tag">historisch</span>}
          </article>
        ))}
      </div>
    </section>
  ))}

  <p id="leer" class="note" hidden>Keine Einträge gefunden.</p>

  <script>
    const feld = document.getElementById('suche') as HTMLInputElement | null;
    const leer = document.getElementById('leer');
    feld?.addEventListener('input', () => {
      const q = feld.value.trim().toLowerCase();
      let treffer = 0;
      document.querySelectorAll<HTMLElement>('[data-sektion]').forEach((sek) => {
        let inSek = 0;
        sek.querySelectorAll<HTMLElement>('article').forEach((a) => {
          const ok = !q || (a.dataset.s ?? '').includes(q);
          a.hidden = !ok;
          if (ok) inSek++;
        });
        sek.hidden = inSek === 0;
        treffer += inSek;
      });
      if (leer) leer.hidden = treffer > 0;
    });
  </script>

  <style>
    section{margin:2.5rem 0}h2{font-weight:400;color:var(--accent)}code{color:var(--accent);font-size:1.05rem}.status{border-left:2px solid var(--accent);padding:1rem 1.25rem;background:#1b1815}.status strong{color:var(--accent)}.status p,.note{color:var(--muted)}#suche{width:100%;padding:.8rem 1rem;margin:1rem 0 0;background:#1b1815;border:1px solid var(--border);color:var(--fg);font:inherit}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.grid article{border:1px solid var(--border);padding:1rem;position:relative}.grid article p{margin:.35rem 0 0}.grid .en{color:var(--muted);font-style:italic;font-size:.9rem}.grid small{display:block;margin-top:.5rem;color:var(--muted);font-size:.8rem}.grid article.h{border-style:dashed}.tag{position:absolute;top:.6rem;right:.75rem;font-size:.7rem;color:var(--muted);letter-spacing:.05em;text-transform:uppercase}@media(max-width:650px){.grid{grid-template-columns:1fr}}
  </style>
</Layout>
