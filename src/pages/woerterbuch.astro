      { w: 'Ra', de: 'Fluss, Zeit, Wachstum', en: 'Flow, time, growth', note: 'V10' },
      { w: 'Bi', de: 'Ansatzpunkt, Quelle; Wärme, Ort, Präsenz', en: 'Source; warmth, place', note: 'V12 · Urgeste Bi' },
      { w: 'Wi', de: 'Kälte, Abwesenheit, Nicht', en: 'Cold, absence, not', note: 'V13' },
      { w: 'Ku', de: 'Hohlraum, Mangel, Suche, Frage', en: 'Hollow, lack, search', note: 'V14 · Urgeste Ku' },
      { w: 'Ma', de: 'Bindung, Nähren, Sicherheit', en: 'Bond, nourishment', note: 'V16 · Urgeste Ma' },
      { w: 'Ta', de: 'Gegenüber, Grenze, das Andere', en: 'Boundary, the other', note: 'V17 · Urgeste Ta · Ta-Konstante' },
      { w: 'Kin', de: 'gerichtete Kraft, Bewegung', en: 'Directed force, motion', note: 'V20' },
    ],
  },
  {
    titel: 'Pronomen',
    eintraege: [
      { w: 'sa-i', de: 'ich', en: 'I', note: 'sa (Selbst/Quelle) + -i' },
      { w: 'ta-i', de: 'du', en: 'you', note: 'ta (Gegenüber) + -i' },
      { w: 'ku-i', de: 'er, sie, es – das Dritte', en: 'he, she, it', note: 'ku (das nicht festgelegte Andere) + -i' },
      { w: 'sa-mira', de: 'wir – jede und jeder einzeln', en: 'we (distributive)', note: 'sa + -mira (distributiv)' },
      { w: 'sa-ona', de: 'wir – als Einheit', en: 'we (collective)', note: 'sa + -ona (kollektiv)' },
    ],
  },
  {
    titel: 'Komposita',
    text: 'Zusammensetzungen aus Vektoren und Urgesten. Der Apostroph markiert die Ta-Stille: eine kurze Pause, in der die Grenze hörbar wird.',
